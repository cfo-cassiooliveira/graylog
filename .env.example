# =====================================================================================
# Variáveis do docker-compose do Graylog (modelo SEM valores reais).
# Recomendado: ./scripts/generate-env.sh  (gera o .env com segredos aleatórios)
# O .env NUNCA é versionado (está no .gitignore). Este arquivo não pode conter valores reais.
# =====================================================================================

# Segredo usado pelo Graylog para cifrar/assinar dados internos. Mínimo 64 caracteres aleatórios.
GRAYLOG_PASSWORD_SECRET=

# Senha do usuário "admin" da UI/API (usada pelo provisionamento) e o SHA-256 dela (exigido pelo Graylog).
#   printf '%s' "<senha>" | sha256sum | cut -d' ' -f1
GRAYLOG_ROOT_PASSWORD=
GRAYLOG_ROOT_PASSWORD_SHA2=

# Senha do usuário "graylog" do MongoDB (rede interna).
MONGODB_PASSWORD=

# Fuso horário exibido na UI.
GRAYLOG_TIMEZONE=America/Sao_Paulo

# Retenção dos logs do legado em dias (LGPD: guarde só pelo tempo necessário).
LOG_RETENTION_DAYS=30

# Memória do OpenSearch (heap da JVM). 1g atende ao ambiente local.
OPENSEARCH_HEAP=1g
