rule "grafana: descartar texto de JSON malformado (LGPD)"
when
  has_field("tag") && to_string($message.tag) == "grafana"
  && starts_with(to_string($message.message), "{")
then
  // Fallback do estágio 1: se o JSON do Grafana veio truncado/inválido, o parse_json da regra do estágio 0 aborta e o
  // texto bruto continuaria em claro: a rede de segurança por formato reconhece e-mail, mas não login nem usuário.
  // Quando a mensagem ainda começa com "{", troca por texto fixo sem nenhum dado do log original.
  set_field("message", "grafana log discarded: malformed JSON");
end
