rule "LGPD: mascarar e-mail e CPF"
when
  has_field("message")
then
  // Defesa em profundidade (LGPD): mesmo que algum serviço logue um dado pessoal por engano,
  // ele é mascarado antes de ser indexado.
  let masked_email = regex_replace(
    pattern: "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}", value: to_string($message.message), replacement: "***@***");
  let masked_cpf = regex_replace(
    pattern: "\\b\\d{3}\\.?\\d{3}\\.?\\d{3}-?\\d{2}\\b", value: masked_email, replacement: "***.***.***-**");
  set_field("message", masked_cpf);
end
