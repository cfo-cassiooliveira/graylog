rule "LGPD: mascarar CPF em __FIELD__"
when
  has_field("__FIELD__")
then
  // Modelo: o provision.sh gera uma regra por campo de LGPD_CPF_FIELDS (troca __FIELD__ pelo nome do campo).
  // O nome do campo diz o tipo do dado: nada é adivinhado (ADR-0002).
  // 0) Valor que já chega mascarado da origem (ADR-0003) fica como está e não é trocado nos textos.
  //    O campo Cpf_token nunca é alterado (nenhuma regra o lê nem o grava).
  let raw = to_string($message.__FIELD__);
  let already_masked = regex_replace(pattern: "(?s)^(?!\\*\\*\\*\\.[0-9]{3}\\.[0-9]{3}-\\*\\*\\z).*", value: raw, replacement: "");
  // 1) O campo vira ***.456.789-** (padrão do governo federal). Valor fora do formato vira *** (nunca fica em claro).
  let digits = regex_replace(pattern: "[^0-9]", value: raw, replacement: "");
  let formatted = regex_replace(pattern: "^[0-9]{3}([0-9]{3})([0-9]{3})[0-9]{2}$", value: digits, replacement: "***.$1.$2-**");
  let generated = regex_replace(pattern: "(?s)^(?!\\*\\*\\*\\.[0-9]{3}\\.[0-9]{3}-\\*\\*$).*$", value: formatted, replacement: "***");
  // A linguagem do pipeline não tem "if": escolhe o valor já mascarado (antes da quebra de linha) ou o gerado.
  let masked = regex_replace(pattern: "(?s)^([^\\n]+)\\n.*|^\\n", value: concat(already_masked, concat("\n", generated)), replacement: "$1");
  set_field("__FIELD__", masked);
  // 2) O mesmo valor dentro dos textos (o Serilog grava "CPF {Cpf}" no campo E no message) vira a máscara (ou ***,
  //    se fora do formato). Troca o valor exato, só como palavra inteira, em qualquer formato que ele tenha no campo.
  //    Não troca (o padrão começa com (?!), que nunca casa) quando o valor já veio mascarado ou quando está fora do
  //    formato E tem menos de 8 dígitos (ADR-0003, item 10), para um valor como "1" não virar *** em todo o texto.
  let is_long = regex_replace(pattern: "(?s)^(?!long\\z).*", value: regex_replace(pattern: "(?s)^.{8,}\\z", value: digits, replacement: "long"), replacement: "");
  let short_invalid = regex_replace(pattern: "(?s)^(?!\\*\\*\\*\\z).*", value: concat(generated, is_long), replacement: "");
  let skip_text = concat(already_masked, short_invalid);
  let text_guard = regex_replace(pattern: "(?s)^.+", value: skip_text, replacement: "(?!)");
  let quoted = regex_replace(pattern: "[\\\\^$.|?*+()\\[\\]{}/-]", value: raw, replacement: "\\\\$0");
  let search_start = concat(text_guard, concat("(?i)(?<![A-Za-z0-9])", quoted));
  let search_pattern = concat(search_start, "(?![A-Za-z0-9])");
  let masked_text = regex_replace(pattern: "[\\\\$]", value: masked, replacement: "\\\\$0");
__REPLACE_IN_TEXT_FIELDS__
end
