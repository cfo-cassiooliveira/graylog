rule "LGPD: mascarar login em __FIELD__"
when
  has_field("__FIELD__")
then
  // Modelo: o provision.sh gera uma regra por campo de LGPD_LOGIN_FIELDS (troca __FIELD__ pelo nome do campo).
  // O nome do campo diz o tipo do dado: nada é adivinhado (ADR-0002). No texto livre um login é só uma palavra;
  // ele só é reconhecido por vir num desses campos.
  // 1) Máscara do ADR-0007 do keycloak (minúsculas; até 3 caracteres, 1 se tiver até 3):
  //    e-mail -> ana***@gmail     outro login -> mar***      (valor já mascarado fica igual)
  let raw = to_string($message.__FIELD__);
  let normalized = lowercase(raw);
  let with_email = regex_replace(pattern: "(?s)^(?:([^@]{3})(?=[^@])|([^@]))[^@]*@([^.@]*).*$", value: normalized, replacement: "$1$2***@$3");
  let masked = regex_replace(pattern: "(?s)^(?:([^@]{3})(?=[^@])|([^@]))[^@]*$", value: with_email, replacement: "$1$2***");
  set_field("__FIELD__", masked);
  // 2) O mesmo valor dentro dos textos (o Serilog grava "{UserName}" no campo E no message) vira a máscara
  //    (valor exato, sem diferenciar maiúsculas, só como palavra inteira).
  let quoted = regex_replace(pattern: "[\\\\^$.|?*+()\\[\\]{}/-]", value: raw, replacement: "\\\\$0");
  let search_start = concat("(?i)(?<![A-Za-z0-9])", quoted);
  let search_pattern = concat(search_start, "(?![A-Za-z0-9])");
  let masked_text = regex_replace(pattern: "[\\\\$]", value: masked, replacement: "\\\\$0");
__REPLACE_IN_TEXT_FIELDS__
end
