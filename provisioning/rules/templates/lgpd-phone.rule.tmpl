rule "LGPD: mascarar telefone em __FIELD__"
when
  has_field("__FIELD__")
then
  // Modelo: o provision.sh gera uma regra por campo de LGPD_PHONE_FIELDS (troca __FIELD__ pelo nome do campo).
  // O nome do campo diz o tipo do dado: nada é adivinhado (ADR-0002). Por isso aqui vale celular e fixo, e
  // "11987654321" é telefone (no texto livre, sem campo, 11 dígitos são tratados como CPF).
  // 1) O campo vira 11*****4321 (DDD e 4 últimos; +55 é descartado). Valor fora do formato vira ***.
  let raw = to_string($message.__FIELD__);
  let digits = regex_replace(pattern: "[^0-9]", value: raw, replacement: "");
  let national = regex_replace(pattern: "^55([0-9]{10,11})$", value: digits, replacement: "$1");
  let formatted = regex_replace(pattern: "^([0-9]{2})[0-9]{4,5}([0-9]{4})$", value: national, replacement: "$1*****$2");
  let masked = regex_replace(pattern: "(?s)^(?![0-9]{2}\\*{5}[0-9]{4}$).*$", value: formatted, replacement: "***");
  set_field("__FIELD__", masked);
  // 2) O mesmo valor dentro dos textos vira a máscara (valor exato, só como palavra inteira).
  let quoted = regex_replace(pattern: "[\\\\^$.|?*+()\\[\\]{}/-]", value: raw, replacement: "\\\\$0");
  let search_start = concat("(?i)(?<![A-Za-z0-9])", quoted);
  let search_pattern = concat(search_start, "(?![A-Za-z0-9])");
  let masked_text = regex_replace(pattern: "[\\\\$]", value: masked, replacement: "\\\\$0");
__REPLACE_IN_TEXT_FIELDS__
end
